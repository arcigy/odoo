<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_arcigy_clients" model="ir.module.category">
        <field name="name">Arcigy klienti</field>
        <field name="sequence">60</field>
    </record>
    <record id="privilege_arcigy_clients" model="res.groups.privilege">
        <field name="name">Arcigy klienti</field>
        <field name="category_id" ref="module_category_arcigy_clients"/>
        <field name="sequence">60</field>
    </record>

    <!-- People who manage client relationships; only they see per-user app results (personal data). -->
    <record id="group_crm_manager" model="res.groups">
        <field name="name">Správca klientov</field>
        <field name="privilege_id" ref="privilege_arcigy_clients"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_admin'))]"/>
    </record>

    <!-- Technical API user of the app's daily export: may only call arcigy_ingest. -->
    <record id="group_crm_ingest" model="res.groups">
        <field name="name">Príjem metrík z aplikácie (technický používateľ)</field>
        <field name="privilege_id" ref="privilege_arcigy_clients"/>
    </record>
</odoo>
