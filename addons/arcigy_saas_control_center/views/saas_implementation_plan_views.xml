<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_saas_implementation_plan_item_list" model="ir.ui.view">
        <field name="name">saas.implementation.plan.item.list</field>
        <field name="model">saas.implementation.plan.item</field>
        <field name="arch" type="xml">
            <list default_order="priority, sequence, id" decoration-danger="priority == 'p0'" decoration-warning="priority == 'p1'" decoration-success="status == 'ready_for_review'">
                <field name="priority" widget="badge"/><field name="status" widget="badge"/><field name="name"/><field name="scope"/><field name="owner_id"/><field name="review_checklist" string="Čo skontrolovať"/><field name="next_action" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_saas_implementation_plan_item_form" model="ir.ui.view">
        <field name="name">saas.implementation.plan.item.form</field>
        <field name="model">saas.implementation.plan.item</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group><group><field name="priority"/><field name="status"/><field name="scope"/><field name="owner_id"/><field name="sequence"/></group><group><field name="source_document" readonly="1"/></group></group>
                    <group string="Execution"><field name="next_action"/><field name="acceptance_criteria"/><field name="review_checklist" required="status == 'ready_for_review'"/><field name="blocker" invisible="status != 'blocked'"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_saas_implementation_plan_items" model="ir.actions.act_window">
        <field name="name">Implementation plan</field><field name="res_model">saas.implementation.plan.item</field><field name="view_mode">list,form</field>
    </record>
</odoo>
