<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_saas_implementation_plan_item_list" model="ir.ui.view">
        <field name="name">saas.implementation.plan.item.list</field>
        <field name="model">saas.implementation.plan.item</field>
        <field name="arch" type="xml">
            <list default_order="sequence, id" decoration-danger="priority == 'p0'" decoration-warning="priority == 'p1'" decoration-success="status == 'ready_for_review'">
                <field name="sequence" string="Poradie"/>
                <field name="status" widget="badge"/>
                <field name="name"/>
                <field name="target_repository"/>
                <field name="target_environment"/>
                <field name="priority" widget="badge" optional="hide"/>
                <field name="owner_id"/>
                <field name="review_checklist" string="Co skontrolovat"/>
                <field name="next_action" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_saas_implementation_plan_item_form" model="ir.ui.view">
        <field name="name">saas.implementation.plan.item.form</field>
        <field name="model">saas.implementation.plan.item</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_done" type="object" string="Schvalit" class="btn-primary" invisible="status != 'ready_for_review'"/>
                    <button name="action_request_changes" type="object" string="Vratit na opravu" invisible="status != 'ready_for_review'"/>
                    <field name="status" widget="statusbar" statusbar_visible="planned,planning,in_progress,testing,deploying,awaiting_approval,ready_for_review,changes_requested,split,blocked,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="priority"/>
                            <field name="scope"/>
                            <field name="target_repository"/>
                            <field name="target_environment"/>
                            <field name="risk_level"/>
                            <field name="owner_id"/>
                            <field name="daily_batch_date" readonly="1"/>
                            <field name="daily_batch_slot" readonly="1"/>
                        </group>
                        <group>
                            <field name="source_document" readonly="1"/>
                            <field name="parent_id" readonly="1"/>
                            <field name="current_codex_run_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Zadanie">
                            <field name="full_prompt" placeholder="Cele zadanie pre Codex..."/>
                            <field name="acceptance_criteria"/>
                            <field name="next_action"/>
                        </page>
                        <page string="Plan">
                            <field name="implementation_plan" readonly="status not in ['planned','changes_requested','planning']"/>
                            <field name="plan_version" readonly="1"/>
                        </page>
                        <page string="Vysledok">
                            <field name="result_summary" readonly="1"/>
                            <field name="review_checklist" required="status == 'ready_for_review'"/>
                            <field name="blocker" invisible="status != 'blocked'" readonly="1"/>
                            <field name="followup_notes"/>
                        </page>
                        <page string="Codex behy">
                            <field name="codex_run_ids" readonly="1">
                                <list>
                                    <field name="started_at"/><field name="phase"/><field name="worker_name"/>
                                    <field name="branch_name"/><field name="commit_sha"/>
                                    <field name="pull_request_url" widget="url"/>
                                    <field name="deployment_url" widget="url"/>
                                    <field name="test_summary"/>
                                </list>
                            </field>
                        </page>
                        <page string="Podulohy" invisible="not child_ids">
                            <field name="child_ids" readonly="1">
                                <list><field name="sequence"/><field name="status"/><field name="name"/><field name="review_checklist"/></list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_saas_implementation_plan_items" model="ir.actions.act_window">
        <field name="name">Implementation plan</field>
        <field name="res_model">saas.implementation.plan.item</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
