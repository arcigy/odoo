<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_saas_implementation_plan_item_list" model="ir.ui.view">
        <field name="name">saas.implementation.plan.item.list</field>
        <field name="model">saas.implementation.plan.item</field>
        <field name="arch" type="xml">
            <list default_order="sequence, id" decoration-danger="priority == 'p0'" decoration-warning="priority == 'p1'">
                <field name="sequence" string="Poradie"/>
                <field name="name"/>
                <field name="target_repository"/>
                <field name="priority" widget="badge" optional="hide"/>
                <field name="owner_id"/>
                <field name="codex_thread_id" string="Codex chat" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_saas_implementation_plan_item_form" model="ir.ui.view">
        <field name="name">saas.implementation.plan.item.form</field>
        <field name="model">saas.implementation.plan.item</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_permanently_delete" type="object" string="Trvalo vymazať úlohu" confirm="Táto úloha a jej historické Odoo záznamy sa natrvalo odstránia. Túto akciu nemožno vrátiť späť. Ostatné úlohy sa automaticky správne prečíslujú." groups="arcigy_saas_control_center.group_saas_administrator"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="priority"/>
                            <field name="scope"/>
                            <field name="target_repository"/>
                            <field name="owner_id"/>
                        </group>
                        <group>
                            <field name="codex_thread_id" string="Codex chat" readonly="1"/>
                            <p invisible="not codex_thread_id">Chat bol vytvorený. Ďalšia komunikácia prebieha už iba priamo v Codexe.</p>
                        </group>
                    </group>
                    <notebook>
                        <page string="Zadanie">
                            <field name="full_prompt" placeholder="Celé zadanie pre Codex..."/>
                            <field name="acceptance_criteria"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_saas_implementation_plan_items" model="ir.actions.act_window">
        <field name="name">Implementation plan</field>
        <field name="res_model">saas.implementation.plan.item</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_saas_implementation_plan_item_kanban" model="ir.ui.view">
        <field name="name">saas.implementation.plan.item.kanban</field>
        <field name="model">saas.implementation.plan.item</field>
        <field name="arch" type="xml">
            <kanban default_order="sequence, id" class="o_arcigy_implementation_queue">
                <field name="name"/>
                <field name="sequence"/>
                <field name="priority"/>
                <field name="codex_thread_id"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_title"><field name="sequence"/> – <field name="name"/></div>
                        <div><field name="priority"/></div>
                        <div t-if="record.codex_thread_id.raw_value"><strong>Codex chat vytvorený</strong></div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_saas_implementation_queue_board" model="ir.actions.act_window">
        <field name="name">Úlohy pre Codex</field>
        <field name="res_model">saas.implementation.plan.item</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{}</field>
    </record>
</odoo>
