                <field name="period_start"/><field name="environment_id"/><field name="service_id"/>
                <field name="open_connections"/><field name="active_connections"/><field name="waiting_connections"/>
                <field name="pool_utilization"/><field name="pool_wait_p95_seconds"/><field name="query_p95_seconds"/>
                <field name="slow_query_count"/><field name="deadlock_count"/><field name="storage_bytes"/>
                <field name="replication_lag_seconds"/><field name="status"/><field name="data_quality_status"/>
            </list>
        </field>
    </record>
    <record id="action_saas_database_hourly" model="ir.actions.act_window">
        <field name="name">Database</field><field name="res_model">saas.database.hourly</field>
        <field name="view_mode">list,pivot,graph</field>
    </record>

    <record id="view_saas_cache_hourly_list" model="ir.ui.view">
