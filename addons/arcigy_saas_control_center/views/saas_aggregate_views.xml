<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- These views expose bounded aggregates only. Raw requests, traces and payloads stay in observability storage. -->
    <record id="view_saas_tenant_daily_list" model="ir.ui.view">
        <field name="name">saas.tenant.daily.list</field>
        <field name="model">saas.tenant.daily</field>
        <field name="arch" type="xml">
            <list default_order="period_start desc" create="false" edit="false" delete="false">
                <field name="period_start"/><field name="environment_id"/><field name="tenant_id"/>
                <field name="plan_id"/><field name="active_users"/><field name="core_actions"/>
                <field name="error_rate"/><field name="p95_seconds"/><field name="mrr"/>
                <field name="operational_cost"/><field name="health_score"/><field name="health_status"/>
                <field name="data_quality_status"/><field name="source_updated_at"/>
            </list>
        </field>
    </record>
    <record id="action_saas_tenant_daily" model="ir.actions.act_window">
        <field name="name">Tenant health</field><field name="res_model">saas.tenant.daily</field>
        <field name="view_mode">list,pivot,graph</field>
    </record>

    <record id="view_saas_endpoint_hourly_list" model="ir.ui.view">
        <field name="name">saas.endpoint.hourly.list</field><field name="model">saas.endpoint.hourly</field>
        <field name="arch" type="xml">
            <list default_order="period_start desc" create="false" edit="false" delete="false">
                <field name="period_start"/><field name="environment_id"/><field name="service_id"/>
                <field name="method"/><field name="endpoint_group"/><field name="slo_class"/>
                <field name="request_count"/><field name="success_count"/><field name="error_count"/>
                <field name="timeout_count"/><field name="rate_limited_count"/><field name="p95_seconds"/>
                <field name="p99_seconds"/><field name="status"/><field name="data_quality_status"/>
            </list>
        </field>
    </record>
    <record id="action_saas_endpoint_hourly" model="ir.actions.act_window">
        <field name="name">API endpoints</field><field name="res_model">saas.endpoint.hourly</field>
        <field name="view_mode">list,pivot,graph</field>
    </record>

    <record id="view_saas_database_hourly_list" model="ir.ui.view">
