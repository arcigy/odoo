    <record id="view_saas_data_quality_run_list" model="ir.ui.view">
        <field name="name">saas.data.quality.run.list</field><field name="model">saas.data.quality.run</field>
        <field name="arch" type="xml">
            <list default_order="started_at desc" create="false" edit="false" delete="false">
                <field name="started_at"/><field name="finished_at"/><field name="environment_id"/>
                <field name="name"/><field name="status"/><field name="events_sent"/>
                <field name="events_received"/><field name="events_processed"/><field name="events_rejected"/>
                <field name="event_stream_complete"/><field name="retry_adjustment_count"/>
                <field name="duplicate_count"/><field name="schema_failure_count"/><field name="missing_field_count"/>
                <field name="late_event_count"/><field name="unknown_tenant_count"/>
                <field name="clock_skew_seconds"/><field name="processing_lag_p95_seconds"/>
                <field name="dead_letter_count"/><field name="metric_quality_contract_complete"/>
                <field name="eligible_metric_count"/><field name="fresh_metric_count"/>
                <field name="complete_metric_count"/><field name="unique_metric_count"/>
                <field name="valid_metric_count"/><field name="consistent_metric_count"/>
                <field name="reconciliation_difference"/><field name="outlier_count"/>
                <field name="unexpected_zero_count"/><field name="unexpected_volume_spike_count"/>
                <field name="numerator_denominator_violation_count"/>
                <field name="negative_value_violation_count"/><field name="missing_dimension_count"/>
                <field name="oldest_unsynced_at"/>
                <field name="source_updated_at"/><field name="external_key" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="action_saas_data_quality_run" model="ir.actions.act_window">
        <field name="name">Data quality</field><field name="res_model">saas.data.quality.run</field>
        <field name="view_mode">list,pivot,graph</field>
    </record>
</odoo>
