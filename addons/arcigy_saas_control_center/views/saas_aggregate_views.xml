    <record id="view_saas_queue_hourly_list" model="ir.ui.view">
        <field name="name">saas.queue.hourly.list</field><field name="model">saas.queue.hourly</field>
        <field name="arch" type="xml">
            <list default_order="period_start desc" create="false" edit="false" delete="false">
                <field name="period_start"/><field name="environment_id"/><field name="service_id"/>
                <field name="queue_name"/><field name="job_type"/><field name="queue_depth"/>
                <field name="oldest_age_seconds"/><field name="processing_rate"/><field name="drain_time_seconds"/>
                <field name="failed_count"/><field name="retry_count"/><field name="dlq_size"/>
                <field name="worker_count"/><field name="status"/><field name="data_quality_status"/>
