                <field name="events_received"/><field name="events_processed"/><field name="events_rejected"/>
                <field name="duplicate_count"/><field name="schema_failure_count"/><field name="missing_field_count"/>
                <field name="late_event_count"/><field name="unknown_tenant_count"/>
                <field name="reconciliation_difference"/><field name="oldest_unsynced_at"/>
                <field name="source_updated_at"/><field name="external_key" optional="hide"/>
            </list>
        </field>
