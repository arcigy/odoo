<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_saas_alert_list" model="ir.ui.view">
        <field name="name">saas.alert.list</field><field name="model">saas.alert</field>
        <field name="arch" type="xml"><list decoration-danger="severity == 'p0'" decoration-warning="severity == 'p1'" default_order="detected_at desc"><field name="detected_at"/><field name="severity" widget="badge"/><field name="status" widget="badge"/><field name="name"/><field name="environment_id"/><field name="scope_key"/><field name="service_id"/><field name="tenant_id"/><field name="incident_id"/><field name="owner_id"/></list></field>
    </record>
    <record id="view_saas_incident_list" model="ir.ui.view">
        <field name="name">saas.incident.list</field><field name="model">saas.incident</field>
        <field name="arch" type="xml"><list decoration-danger="severity == 'p0'" decoration-warning="severity == 'p1'" default_order="detected_at desc"><field name="detected_at"/><field name="severity" widget="badge"/><field name="status" widget="badge"/><field name="name"/><field name="environment_id"/><field name="release_id"/><field name="affected_users"/><field name="affected_mrr"/><field name="owner_id"/></list></field>
    </record>
    <record id="view_saas_incident_form" model="ir.ui.view">
        <field name="name">saas.incident.form</field><field name="model">saas.incident</field>
        <field name="arch" type="xml"><form><sheet><group><group><field name="name"/><field name="severity"/><field name="status"/><field name="environment_id"/><field name="owner_id"/></group><group><field name="detected_at"/><field name="acknowledged_at"/><field name="mitigated_at"/><field name="resolved_at"/><field name="release_id"/></group></group><group string="Impact"><field name="service_ids" widget="many2many_tags"/><field name="tenant_ids" widget="many2many_tags"/><field name="affected_users"/><field name="affected_mrr"/></group><group string="Response"><field name="root_cause"/><field name="triggering_metric_id"/><field name="alert_id"/><field name="runbook_url" widget="url"/><field name="external_dashboard_url" widget="url"/><field name="postmortem_url" widget="url"/></group><field name="postmortem_action_ids"><list editable="bottom"><field name="name"/><field name="owner_id"/><field name="deadline"/><field name="status"/><field name="verification"/></list></field></sheet><chatter/></form></field>
    </record>
    <record id="view_saas_backup_run_list" model="ir.ui.view"><field name="name">saas.backup.run.list</field><field name="model">saas.backup.run</field><field name="arch" type="xml"><list default_order="started_at desc"><field name="started_at"/><field name="environment_id"/><field name="name"/><field name="backup_type"/><field name="status" widget="badge"/><field name="size_bytes"/><field name="encrypted"/><field name="off_host"/><field name="source_updated_at"/><field name="external_key" optional="hide"/></list></field></record>
    <record id="view_saas_restore_test_list" model="ir.ui.view"><field name="name">saas.restore.test.list</field><field name="model">saas.restore.test</field><field name="arch" type="xml"><list default_order="started_at desc"><field name="started_at"/><field name="finished_at"/><field name="environment_id"/><field name="name"/><field name="status" widget="badge"/><field name="actual_rpo_seconds"/><field name="rpo_measured"/><field name="actual_rto_seconds"/><field name="rto_measured"/><field name="checksum_valid"/><field name="application_smoke_passed"/><field name="tenant_isolation_passed"/><field name="source_updated_at"/><field name="external_key" optional="hide"/></list></field></record>
    <record id="view_saas_load_test_list" model="ir.ui.view"><field name="name">saas.load.test.list</field><field name="model">saas.load.test</field><field name="arch" type="xml"><list default_order="started_at desc"><field name="started_at"/><field name="finished_at"/><field name="environment_id"/><field name="release_id"/><field name="architecture_version"/><field name="representative"/><field name="test_type"/><field name="status" widget="badge"/><field name="concurrent_users"/><field name="requests_per_second"/><field name="p95_seconds"/><field name="p99_seconds"/><field name="error_rate"/><field name="source_updated_at"/><field name="external_key" optional="hide"/></list></field></record>
    <record id="view_saas_sync_run_list" model="ir.ui.view"><field name="name">saas.sync.run.list</field><field name="model">saas.sync.run</field><field name="arch" type="xml"><list default_order="started_at desc"><field name="started_at"/><field name="environment_id"/><field name="name"/><field name="status" widget="badge"/><field name="records_read"/><field name="records_created"/><field name="records_updated"/><field name="records_rejected"/><field name="retry_count"/><field name="error_code"/></list></field></record>
    <record id="action_saas_alerts" model="ir.actions.act_window"><field name="name">Alerts</field><field name="res_model">saas.alert</field><field name="view_mode">list,form</field></record>
    <record id="action_saas_incidents" model="ir.actions.act_window"><field name="name">Incidents</field><field name="res_model">saas.incident</field><field name="view_mode">list,form</field></record>
    <record id="action_saas_backup_runs" model="ir.actions.act_window"><field name="name">Backup runs</field><field name="res_model">saas.backup.run</field><field name="view_mode">list,form</field></record>
    <record id="action_saas_restore_tests" model="ir.actions.act_window"><field name="name">Restore tests</field><field name="res_model">saas.restore.test</field><field name="view_mode">list,form</field></record>
    <record id="action_saas_load_tests" model="ir.actions.act_window"><field name="name">Load tests</field><field name="res_model">saas.load.test</field><field name="view_mode">list,form</field></record>
    <record id="action_saas_sync_runs" model="ir.actions.act_window"><field name="name">Odoo sync runs</field><field name="res_model">saas.sync.run</field><field name="view_mode">list,form</field></record>
</odoo>
