<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="module_category_saas_control_center" model="ir.module.category">
            <field name="name">Arcigy SaaS Control Center</field>
            <field name="sequence">35</field>
        </record>
        <record id="privilege_saas_control_center" model="res.groups.privilege">
            <field name="name">Arcigy SaaS Control Center</field>
            <field name="category_id" ref="module_category_saas_control_center"/>
            <field name="sequence">35</field>
        </record>

        <record id="group_saas_executive" model="res.groups">
            <field name="name">SaaS Executive</field>
            <field name="privilege_id" ref="privilege_saas_control_center"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="group_saas_finance" model="res.groups">
            <field name="name">SaaS Finance</field>
            <field name="privilege_id" ref="privilege_saas_control_center"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="group_saas_customer_success" model="res.groups">
            <field name="name">SaaS Customer Success</field>
            <field name="privilege_id" ref="privilege_saas_control_center"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="group_saas_support" model="res.groups">
            <field name="name">SaaS Support</field>
            <field name="privilege_id" ref="privilege_saas_control_center"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="group_saas_engineering" model="res.groups">
            <field name="name">SaaS Engineering</field>
            <field name="privilege_id" ref="privilege_saas_control_center"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="group_saas_security" model="res.groups">
            <field name="name">SaaS Security</field>
            <field name="privilege_id" ref="privilege_saas_control_center"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="group_saas_administrator" model="res.groups">
            <field name="name">SaaS Administrator</field>
            <field name="privilege_id" ref="privilege_saas_control_center"/>
            <field name="implied_ids" eval="[
                (4, ref('group_saas_executive')),
                (4, ref('group_saas_finance')),
                (4, ref('group_saas_customer_success')),
                (4, ref('group_saas_support')),
                (4, ref('group_saas_engineering')),
                (4, ref('group_saas_security'))
            ]"/>
        </record>
        <record id="group_saas_integration_bot" model="res.groups">
            <field name="name">SaaS Integration Bot</field>
            <field name="privilege_id" ref="privilege_saas_control_center"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="group_saas_codex_worker" model="res.groups">
            <field name="name">Arcigy Codex Worker</field>
            <field name="privilege_id" ref="privilege_saas_control_center"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_metric_definition_executive" model="ir.rule">
            <field name="name">Executive sees all metric definitions</field>
            <field name="model_id" ref="model_saas_metric_definition"/>
            <field name="groups" eval="[(4, ref('group_saas_executive'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="rule_metric_current_executive" model="ir.rule">
            <field name="name">Executive sees all current metrics</field>
            <field name="model_id" ref="model_saas_metric_current"/>
            <field name="groups" eval="[(4, ref('group_saas_executive'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="rule_metric_timeseries_executive" model="ir.rule">
            <field name="name">Executive sees all historical metrics</field>
            <field name="model_id" ref="model_saas_metric_timeseries"/>
            <field name="groups" eval="[(4, ref('group_saas_executive'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_metric_definition_engineering" model="ir.rule">
            <field name="name">Engineering metric definitions</field>
            <field name="model_id" ref="model_saas_metric_definition"/>
            <field name="groups" eval="[(4, ref('group_saas_engineering'))]"/>
            <field name="domain_force">[('audience', 'in', ['general', 'engineering'])]</field>
        </record>
        <record id="rule_metric_current_engineering" model="ir.rule">
