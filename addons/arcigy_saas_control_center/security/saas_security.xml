            <field name="groups" eval="[(4, ref('group_saas_support'))]"/>
            <field name="domain_force">[('metric_id.audience', 'in', ['general', 'support'])]</field>
        </record>

        <record id="rule_metric_definition_security" model="ir.rule">
            <field name="name">Security metric definitions</field>
            <field name="model_id" ref="model_saas_metric_definition"/>
            <field name="groups" eval="[(4, ref('group_saas_security'))]"/>
